generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  CANCELED
  REFUNDED
}

enum AccessTokenStatus {
  ACTIVE
  REDEEMED
  DISABLED
}

enum UserRole {
  MEMBER
  ADMIN
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  name          String?
  passwordHash  String?
  role          UserRole           @default(MEMBER)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  entitlements  Entitlement[]
  accessTokens  AccessToken[]
  progress      ReaderProgress[]
  favorites     Favorite[]
  workbook      WorkbookEntry[]
  mindSessions  MindSession[]
  purchaseLogs  PurchaseEvent[]
  passwordResets PasswordResetToken[]
}

model Product {
  id           String        @id @default(cuid())
  key          String        @unique
  name         String
  description  String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  entitlements Entitlement[]
}

model Entitlement {
  id         String            @id @default(cuid())
  userId     String
  productId  String?
  productKey String
  status     EntitlementStatus @default(ACTIVE)
  source     String?
  expiresAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product?          @relation(fields: [productId], references: [id])

  @@index([userId, productKey, status])
}

model AccessToken {
  id          String            @id @default(cuid())
  code        String            @unique
  plan        String            @default("basic")
  status      AccessTokenStatus @default(ACTIVE)
  userId      String?
  redeemedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ReaderProgress {
  id          String   @id @default(cuid())
  userId      String
  chapterId   String
  pageIndex   Int      @default(0)
  globalPage  Int?
  progress    Float    @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  chapterId  String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model WorkbookEntry {
  id         String   @id @default(cuid())
  userId     String
  promptId   String
  prompt     String
  content    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, promptId])
}

model MindSession {
  id        String   @id @default(cuid())
  userId    String
  topic     String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PurchaseEvent {
  id          String   @id @default(cuid())
  userId      String?
  provider    String
  eventType   String
  externalId  String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, externalId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model BookAudioRevision {
  id          String    @id @default(cuid())
  chapterId   String
  sectionKey  String
  label       String
  url         String
  coverUrl    String?
  version     Int       @default(1)
  createdById String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([chapterId, sectionKey, createdAt])
  @@index([chapterId, sectionKey, publishedAt])
}

model BookAudioTrackMeta {
  id               String   @id @default(cuid())
  chapterId        String
  sectionKey       String
  productionStatus String   @default("review")
  productionNote   String?
  coverUrl         String?
  sortOrder        Int      @default(0)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([chapterId, sectionKey])
  @@index([chapterId, sortOrder])
}

// Degustação do iGentMIND (72h, 15 msgs/dia) concedida a quem compra o produto
// base. Chaveada por e-mail porque o webhook pode chegar antes do cadastro.
// status: disponivel | ativo | expirado | cancelado
model MindTrial {
  id                 String           @id @default(cuid())
  email              String           @unique
  status             String           @default("disponivel")
  source             String?
  externalId         String?
  purchasedAt        DateTime
  activationDeadline DateTime
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  dailyDate          String?
  dailyCount         Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  events             MindTrialEvent[]

  @@index([status, trialEndsAt])
}

// Eventos de e-mail da degustação: trial_ativado | trial_dia2 | trial_expirado.
// O unique garante um disparo por tipo mesmo com o sweep rodando em paralelo.
model MindTrialEvent {
  id          String    @id @default(cuid())
  trialId     String
  type        String
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  trial       MindTrial @relation(fields: [trialId], references: [id], onDelete: Cascade)

  @@unique([trialId, type])
}

enum QuizLeadStatus {
  novo
  carta_enviada
  em_conversa
  comprou
  descadastrado
}

// Leads do quiz "Qual dilema te mantém desacreditado?" da LP. Tabela própria,
// sem relação com User: quem refaz o quiz gera outro registro (o admin agrupa
// por WhatsApp) e a exclusão por LGPD apaga de verdade.
model QuizLead {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  nome            String
  whatsapp        String // só dígitos, sem DDI (DDD + número)
  email           String?
  consentimento   Boolean
  consentimentoEm DateTime
  prologo         String?
  pilarResultado  String // pilar_1 … pilar_9
  pontuacoes      Json
  cartaUrl        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  gclid           String?
  eventId         String         @unique
  fbc             String?
  fbp             String?
  pageUrl         String?
  ip              String?
  userAgent       String?
  status          QuizLeadStatus @default(novo)
  cartaEnviadaEm  DateTime?
  compradorEm     DateTime?
  observacao      String?

  @@index([createdAt])
  @@index([pilarResultado])
  @@index([status])
  @@index([whatsapp])
  @@index([email])
}
